{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "GR00T N1.7: debug finetune (8 GPUs, 10 steps)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "module": "torch.distributed.run",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": true,
            "args": [
                "--nproc_per_node=8",
                "--master_port=29501",
                "${workspaceFolder}/gr00t/experiment/launch_finetune.py",
                "--base_model_path",
                "${workspaceFolder}/checkpoints/nvidia-GR00T-N1.7-3B",
                "--backbone_model_path",
                "${workspaceFolder}/checkpoints/nvidia-Cosmos-Reason2-2B",
                "--dataset_path_groups",
                "/liujinxin/liyifan/Isaac-GR00T/dataset/G1_real_6D_window_cont_rel_0518-0604",
                "--dataset_embodiment_tags",
                "UNITREE_G1_29DOF",
                "--dataset_mix_ratios",
                "1",
                "--num_gpus",
                "8",
                "--output_dir",
                "${workspaceFolder}/checkpoints/debug_G1_real_8gpu",
                "--save_total_limit",
                "1",
                "--save_steps",
                "1000",
                "--max_steps",
                "10",
                "--warmup_ratio",
                "0.05",
                "--weight_decay",
                "1e-5",
                "--learning_rate",
                "1e-4",
                "--global_batch_size",
                "8",
                "--dataloader_num_workers",
                "0",
                "--color_jitter_params",
                "brightness",
                "0.3",
                "contrast",
                "0.4",
                "saturation",
                "0.5",
                "hue",
                "0.08",
                "--shortest_image_edge",
                "256",
                "--crop_fraction",
                "0.92",
                "--random_rotation_angle",
                "3",
                "--state_dropout_prob",
                "0.1"
            ],
            "env": {
                "CUDA_VISIBLE_DEVICES": "0,1,2,3,4,5,6,7",
                "CUDA_LAUNCH_BLOCKING": "1",
                "HF_HUB_OFFLINE": "1",
                "TRANSFORMERS_OFFLINE": "1",
                "LOGURU_LEVEL": "INFO",
                "NCCL_DEBUG": "INFO",
                "PYTHONUNBUFFERED": "1",
                "TORCH_DISTRIBUTED_DEBUG": "DETAIL"
            }
        },
        {
            "name": "GR00T N1.7: reproduce full finetune (8 GPUs)",
